# ============================================
# Frontend Configuration
# ============================================

# Backend API URL
VITE_API_URL=http://localhost:3000/api

# Stripe Publishable Key (Test Mode)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ============================================
# Supabase Configuration (Legacy - Optional)
# ============================================
# Получите эти значения из Supabase Dashboard → Settings → API

# Project URL (например: https://xxxxx.supabase.co)
VITE_SUPABASE_URL=your_supabase_project_url

# Anon/Public Key (публичный ключ для клиента)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Key (ТОЛЬКО для серверной части, НЕ используйте в клиенте!)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# Локальная разработка (Supabase Local)
# ============================================
# Раскомментируйте для локальной разработки

# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ============================================
# Дополнительные настройки
# ============================================

# Режим разработки
VITE_DEV_MODE=true

# URL приложения (для email редиректов)
VITE_APP_URL=http://localhost:5173

# Yandex Maps API (если нужен)
# VITE_YANDEX_MAPS_API_KEY=your_yandex_maps_key
