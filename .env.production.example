# API URL (замените на ваш production backend URL)
VITE_API_URL="https://your-backend-api.com/api"

# Yandex Maps API Key (если используется)
VITE_YANDEX_MAPS_API_KEY="your-yandex-maps-api-key"

# Stripe Public Key (если используется)
VITE_STRIPE_PUBLIC_KEY="pk_live_your_stripe_public_key"

# Sentry DSN для мониторинга ошибок
VITE_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# Google Analytics Measurement ID
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Cloudinary (опционально, для оптимизации изображений)
VITE_CLOUDINARY_CLOUD_NAME="your-cloud-name"
VITE_CLOUDINARY_API_KEY="your-api-key"
