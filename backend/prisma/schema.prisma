// Prisma Schema для MM05 Furniture Store
// Production-ready схема с авторизацией

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  NEW // Новый заказ (только создан)
  RESERVED // Товар зарезервирован
  CONFIRMED // Подтвержден менеджером
  PROCESSING // В обработке
  SHIPPED // Отправлен
  DELIVERED // Доставлен
  COMPLETED // Завершен
  CANCELLED // Отменен
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum DeliveryMethod {
  PICKUP // Самовывоз из магазина MM05
  COURIER // Доставка курьером (маршрут на карте)
}

// =====================================================
// MODELS
// =====================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String?  @map("full_name")
  phone        String?
  role         UserRole @default(USER)

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  // Relations
  cart          Cart?
  orders        Order[]
  refreshTokens RefreshToken[]
  reviews       Review[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  imageUrl    String? @map("image_url")
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  products Product[]

  @@map("categories")
}

model Product {
  id               String   @id @default(uuid())
  categoryId       String?  @map("category_id")
  name             String
  slug             String   @unique
  description      String?
  shortDescription String?  @map("short_description")
  price            Decimal  @db.Decimal(10, 2)
  oldPrice         Decimal? @map("old_price") @db.Decimal(10, 2)
  assemblyPrice    Decimal? @map("assembly_price") @db.Decimal(10, 2) // Цена сборки (опционально)
  images           Json     @default("[]")
  thumbnailUrl     String?  @map("thumbnail_url")
  specifications   Json     @default("{}")
  stockQuantity    Int      @default(0) @map("stock_quantity")
  isActive         Boolean  @default(true) @map("is_active")
  isFeatured       Boolean  @default(false) @map("is_featured")
  badge            String?
  viewsCount       Int      @default(0) @map("views_count")
  salesCount       Int      @default(0) @map("sales_count")

  // Расширенная конфигурация товара
  // Структура JSON для configuration:
  // {
  //   "variants": {
  //     "size": {
  //       "label": "Размер спального места",
  //       "required": true,
  //       "options": [
  //         { "value": "140x200", "label": "140×200 см (полуторная)", "priceModifier": -5000, "default": true },
  //         { "value": "160x200", "label": "160×200 см (двуспальная)", "priceModifier": 0 },
  //         { "value": "180x200", "label": "180×200 см (king size)", "priceModifier": 8000 }
  //       ]
  //     },
  //     "color": {
  //       "label": "Цвет покрытия",
  //       "required": true,
  //       "options": [
  //         { "value": "natural", "label": "Натуральный дуб", "priceModifier": 0, "image": "/images/bed-natural.jpg", "default": true },
  //         { "value": "dark", "label": "Темный орех", "priceModifier": 2000, "image": "/images/bed-dark.jpg" },
  //         { "value": "white", "label": "Белый", "priceModifier": 3000, "image": "/images/bed-white.jpg" }
  //       ]
  //     }
  //   },
  //   "options": {
  //     "headboard": {
  //       "label": "Изголовье",
  //       "type": "select",
  //       "options": [
  //         { "value": "standard", "label": "Стандартное", "priceModifier": 0, "default": true },
  //         { "value": "soft-fabric", "label": "Мягкое (ткань)", "priceModifier": 5000 },
  //         { "value": "soft-leather", "label": "Мягкое (кожа)", "priceModifier": 12000 }
  //       ]
  //     },
  //     "mattress": {
  //       "label": "Добавить матрас",
  //       "type": "toggle",
  //       "price": 15000,
  //       "description": "Ортопедический матрас"
  //     },
  //     "delivery": {
  //       "label": "Доставка и подъем",
  //       "type": "select",
  //       "required": true,
  //       "options": [
  //         { "value": "pickup", "label": "Самовывоз", "priceModifier": 0, "default": true },
  //         { "value": "city", "label": "Доставка по городу", "priceModifier": 2000 },
  //         { "value": "floor5", "label": "Доставка + подъем до 5 этажа", "priceModifier": 3500 },
  //         { "value": "floor5plus", "label": "Доставка + подъем выше 5 этажа", "priceModifier": 5000 }
  //       ]
  //     }
  //   }
  // }
  configuration Json? @default("{}") // Полная конфигурация товара (варианты + опции)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId])
  @@index([categoryId, isActive, isFeatured])
  @@index([price, isActive])
  @@index([slug])
  @@index([isActive])
  @@map("products")
}

model Order {
  id            String        @id @default(uuid())
  userId        String?       @map("user_id") // Nullable для гостевых заказов
  orderNumber   String        @unique @map("order_number")
  status        OrderStatus   @default(NEW)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  subtotal      Decimal       @db.Decimal(10, 2)
  deliveryCost  Decimal       @default(0) @map("delivery_cost") @db.Decimal(10, 2)
  discount      Decimal       @default(0) @map("discount") @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)

  // Доставка
  deliveryMethod      DeliveryMethod @default(PICKUP) @map("delivery_method")
  deliveryLat         Float?         @map("delivery_lat")
  deliveryLng         Float?         @map("delivery_lng")
  deliveryDistanceKm  Float?         @map("delivery_distance_km")
  deliveryDurationMin Int?           @map("delivery_duration_min")

  // Payment info
  stripeSessionId String? @map("stripe_session_id")
  stripePaymentId String? @map("stripe_payment_id")
  idempotencyKey  String? @unique @map("idempotency_key")

  // Унифицированные поля платёжного провайдера ('STRIPE' | 'YOOKASSA')
  paymentProvider   String? @map("payment_provider")
  providerPaymentId String? @map("provider_payment_id")

  // Customer info
  customerName    String  @map("customer_name")
  customerEmail   String? @map("customer_email")
  customerPhone   String  @map("customer_phone")
  deliveryAddress String  @map("delivery_address") // Текстовый адрес (или строковое представление точки с карты)
  customerNote    String? @map("customer_note")
  adminNote       String? @map("admin_note")

  // Stock reservation
  isStockReserved Boolean   @default(false) @map("is_stock_reserved")
  reservedAt      DateTime? @map("reserved_at")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  paidAt      DateTime? @map("paid_at")
  confirmedAt DateTime? @map("confirmed_at")
  shippedAt   DateTime? @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  // Relations
  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([userId, status])
  @@index([createdAt, status])
  @@index([customerPhone, status])
  @@index([orderNumber])
  @@index([status])
  @@index([stripeSessionId])
  @@index([providerPaymentId])
  @@index([customerPhone])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String  @map("order_id")
  productId       String? @map("product_id")
  productSnapshot Json    @map("product_snapshot") // Сохраняем название, цену, конфигурацию
  quantity        Int
  price           Decimal @db.Decimal(10, 2) // Цена за единицу
  total           Decimal @db.Decimal(10, 2) // Итого за позицию
  options         Json?   @default("{}") // Доп. опции (сборка, доставка и т.д.)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?     @map("user_id")
  action    AuditAction
  entity    String // e.g., "Product", "Order", "User"
  entityId  String?     @map("entity_id")
  changes   Json? // Store what changed
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model Review {
  id         String  @id @default(uuid())
  productId  String  @map("product_id")
  userId     String  @map("user_id")
  rating     Int // 1-5 stars
  comment    String? @db.Text
  isApproved Boolean @default(false) @map("is_approved") // Модерация отзывов

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId]) // Один пользователь - один отзыв на товар
  @@index([productId])
  @@index([userId])
  @@index([isApproved])
  @@map("reviews")
}

model Cart {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String @map("cart_id")
  productId String @map("product_id")
  quantity  Int    @default(1)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId]) // Один товар может быть только один раз в корзине
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}
