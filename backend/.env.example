# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mm05_db"

# JWT Secrets (ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ В PRODUCTION!)
# Используйте: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="your-super-secret-access-key-min-32-chars-CHANGE-THIS"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars-CHANGE-THIS"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CSRF Protection Secret (ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ В PRODUCTION!)
# Используйте: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET="your-super-secret-csrf-key-min-32-chars-CHANGE-THIS"

# App
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Stripe (Test Mode)
# Get your keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"
# Get webhook secret from: https://dashboard.stripe.com/test/webhooks
# Or use Stripe CLI: stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Email / SMTP (опционально - для отправки уведомлений клиентам)
# Если не настроено, email уведомления будут пропущены
# Примеры провайдеров: Gmail, SendGrid, Mailgun, AWS SES
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="MM05 Мебель <noreply@mm05.ru>"

# Admin credentials (для создания первого админа через npm run create-admin)
ADMIN_EMAIL="admin@mm05.ru"
ADMIN_PASSWORD="create-secure-password-here"
ADMIN_FULL_NAME="Администратор"

# Sentry DSN для мониторинга ошибок (опционально)
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
