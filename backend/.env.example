# Backend
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mm05_db

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_hex_chars
JWT_REFRESH_SECRET=replace_with_different_64_hex_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CSRF_SECRET=replace_with_64_hex_chars

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Платёжный провайдер: STRIPE (по умолчанию) | YOOKASSA (СБП)
PAYMENT_PROVIDER=STRIPE
# ЮKassa — обязательны при PAYMENT_PROVIDER=YOOKASSA (https://yookassa.ru)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Переопределение IP-allowlist вебхуков (csv, IPv4/CIDR); по умолчанию — официальные сети ЮKassa
# YOOKASSA_WEBHOOK_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25
# URL вебхука в личном кабинете ЮKassa: https://<backend>/api/webhook/yookassa
# Тестовый URL API (только для мок-сервера; в production НЕ задавать)
# YOOKASSA_API_URL=

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MM05 <noreply@mm05.ru>

# Optional first admin creation
ADMIN_EMAIL=admin@mm05.ru
ADMIN_PASSWORD=replace_with_secure_password
ADMIN_FULL_NAME=Administrator

# Optional monitoring
SENTRY_DSN=

# YooKassa (СБП). PAYMENT_PROVIDER=YOOKASSA включает этот провайдер.
# STRIPE_* при этом можно не заполнять — они нужны только для STRIPE.
PAYMENT_PROVIDER=STRIPE
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Список IP уведомлений через запятую; пусто = официальные сети ЮKassa
YOOKASSA_WEBHOOK_IPS=

# Сколько минут держать резерв склада под неоплаченный заказ.
# Просроченные резервы снимает фоновый sweeper (раз в 5 минут).
STOCK_RESERVATION_TTL_MINUTES=60

# Политика cookie для авторизации и CSRF.
#   none   — дефолт в production: фронт (vercel.app) и API (railway.app) — разные сайты;
#   lax    — если фронт и API на одном домене (например mm05.ru + api.mm05.ru);
#   strict — только тот же сайт.
COOKIE_SAME_SITE=none

# Разрешить любые *.vercel.app origin в CORS (preview-деплои).
# Включайте только если preview-ссылки реально нужны: с credentials:true это
# открывает API любому чужому Vercel-проекту.
ALLOW_VERCEL_PREVIEWS=false
