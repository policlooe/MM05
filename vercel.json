{
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?!assets/|favicon.svg|favicon.ico|site.webmanifest|robots.txt|sitemap.xml|og.png).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
